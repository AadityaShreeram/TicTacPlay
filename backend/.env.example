# Backend server
PORT=4000                  # Port where backend listens

# MySQL database
MYSQL_HOST=mysql           # Hostname of the MySQL service (Docker service name)
MYSQL_USER=root            # MySQL username
MYSQL_PASSWORD=root        # MySQL password
MYSQL_DATABASE=tictacplay  # Database name

# Redis (for matchmaking queue)
REDIS_HOST=redis           # Hostname of Redis service (Docker service name)
REDIS_PORT=6379            # Redis port
